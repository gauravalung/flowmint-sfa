{
  "name": "@flowmint/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate -m db/migrations --migration-file-language sql",
    "migrate:up": "node-pg-migrate up -m db/migrations --migration-file-language sql",
    "seed": "tsx db/seed.ts",
    "create-employee": "tsx scripts/create-employee.ts"
  },
  "dependencies": {
    "@flowmint/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^9.0.8",
    "node-pg-migrate": "^7.6.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
