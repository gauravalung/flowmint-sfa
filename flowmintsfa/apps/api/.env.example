DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flowmint?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
RESET_TOKEN_SECRET="change-me-reset-secret"
VERIFICATION_TOKEN_SECRET="change-me-verification-secret"
PORT=4000

# OTP provider — leave blank in dev; OTPs are logged to console instead of sent.
OTP_PROVIDER="console"
MSG91_API_KEY=""
MSG91_SENDER_ID=""

# Admin CLI script auth — not an HTTP-reachable secret, just a local guard
# so create-employee.ts fails loudly if DATABASE_URL isn't set correctly.
ADMIN_SEED_ENV="development"
